bool IsTrendMoveEntryAllowed(
   const bool wantBuyTrend
)
{
   if(
      !InpUseTrendMoveBlock ||
      InpMaxTrendMovePips <= 0.0
   )
   {
      return true;
   }


   double crossPrice  = 0.0;
   double maxMovePips = 0.0;
   int crossShift     = -1;


   if(
      !GetTrendMoveSinceLastCross(
         wantBuyTrend,
         crossPrice,
         maxMovePips,
         crossShift
      )
   )
   {
      PrintFormat(
         "SKIP %s: nie można sprawdzić ruchu od przecięcia trendowego.",
         wantBuyTrend ? "BUY" : "SELL"
      );

      return false;
   }


   PrintFormat(
      "TREND %s: przecięcie=%.5f, maksymalny ruch=%.1f pips, limit=%.1f pips.",
      wantBuyTrend ? "BUY" : "SELL",
      crossPrice,
      maxMovePips,
      InpMaxTrendMovePips
   );


   if(maxMovePips >= InpMaxTrendMovePips)
   {
      PrintFormat(
         "SKIP %s: trend osiągnął %.1f pips. Limit=%.1f. Blokada do następnego przecięcia trendowego.",
         wantBuyTrend ? "BUY" : "SELL",
         maxMovePips,
         InpMaxTrendMovePips
      );

      return false;
   }


   return true;
}


//==================================================
// SPRAWDZENIE OTWARTEJ POZYCJI
//==================================================

bool HasOpenPositionForThisEA()
{
   for(
      int index = PositionsTotal() - 1;
      index >= 0;
      index--
   )
   {
      ulong ticket =
         PositionGetTicket(index);


      if(ticket == 0)
         continue;


      if(!PositionSelectByTicket(ticket))
         continue;


      string positionSymbol = PositionGetString(
         POSITION_SYMBOL
      );

      long positionMagic = PositionGetInteger(
         POSITION_MAGIC
      );


      if(positionSymbol != Symbol())
         continue;


      if(positionMagic != (long)InpMagic)
         continue;


      return true;
   }


   return false;
}


//==================================================
// TYLKO JEDNA POZYCJA NARAZ
//==================================================

bool IsSingleOpenPositionAllowed()
{
   if(!InpOnlyOneOpenPosition)
      return true;


   if(HasOpenPositionForThisEA())
   {
      Print(
         "SKIP: istnieje już otwarta pozycja tego EA. Kolejna może zostać otwarta po jej zamknięciu."
      );

      return false;
   }


   return true;
}


//==================================================
// LICZENIE WEJŚĆ OD PRZECIĘCIA TRENDU
//==================================================

int CountEntriesSinceTrendCross(
   const bool wantBuyTrend,
   datetime &crossTime,
   int &crossShift
)
{
   crossTime  = 0;
   crossShift = -1;


   double crossPrice  = 0.0;
   double maxMovePips = 0.0;


   if(
      !GetTrendMoveSinceLastCross(
         wantBuyTrend,
         crossPrice,
         maxMovePips,
         crossShift
      )
   )
   {
      return -1;
   }


   crossTime = iTime(
      Symbol(),
      Period(),
      crossShift
   );


   if(crossTime <= 0)
      return -1;


   ResetLastError();


   if(
      !HistorySelect(
         crossTime,
         TimeCurrent()
      )
   )
   {
      PrintFormat(
         "HistorySelect nie powiódł się. Błąd=%d.",
         GetLastError()
      );

      return -1;
   }


   int entries    = 0;
   int totalDeals = HistoryDealsTotal();


   for(
      int index = 0;
      index < totalDeals;
      index++
   )
   {
      ulong dealTicket =
         HistoryDealGetTicket(index);


      if(dealTicket == 0)
         continue;


      string dealSymbol = HistoryDealGetString(
         dealTicket,
         DEAL_SYMBOL
      );

      long dealMagic = HistoryDealGetInteger(
         dealTicket,
         DEAL_MAGIC
      );


      if(dealSymbol != Symbol())
         continue;


      if(dealMagic != (long)InpMagic)
         continue;


      ENUM_DEAL_ENTRY dealEntry =
         (ENUM_DEAL_ENTRY)HistoryDealGetInteger(
            dealTicket,
            DEAL_ENTRY
         );


      if(
         dealEntry != DEAL_ENTRY_IN &&
         dealEntry != DEAL_ENTRY_INOUT
      )
      {
         continue;
      }


      ENUM_DEAL_TYPE dealType =
         (ENUM_DEAL_TYPE)HistoryDealGetInteger(
            dealTicket,
            DEAL_TYPE
         );


      if(
         wantBuyTrend &&
         dealType == DEAL_TYPE_BUY
      )
      {
         entries++;
      }
      else if(
         !wantBuyTrend &&
         dealType == DEAL_TYPE_SELL
      )
      {
         entries++;
      }
   }


   return entries;
}


//==================================================
// LIMIT POZYCJI W TRENDZIE
//==================================================

bool IsTrendPositionLimitAllowed(
   const bool wantBuyTrend
)
{
   if(InpMaxPositionsPerTrend <= 0)
      return true;


   datetime crossTime = 0;
   int crossShift     = -1;


   int entries = CountEntriesSinceTrendCross(
      wantBuyTrend,
      crossTime,
      crossShift
   );


   if(entries < 0)
   {
      PrintFormat(
         "SKIP %s: nie można sprawdzić liczby wejść w trendzie.",
         wantBuyTrend ? "BUY" : "SELL"
      );

      return false;
   }


   PrintFormat(
      "TREND %s: wykorzystane wejścia=%d/%d, początek=%s.",
      wantBuyTrend ? "BUY" : "SELL",
      entries,
      InpMaxPositionsPerTrend,
      TimeToString(
         crossTime,
         TIME_DATE | TIME_MINUTES
      )
   );


   if(entries >= InpMaxPositionsPerTrend)
   {
      PrintFormat(
         "SKIP %s: wykorzystano już %d wejścia w tym trendzie.",
         wantBuyTrend ? "BUY" : "SELL",
         InpMaxPositionsPerTrend
      );

      return false;
   }


   return true;
}


//==================================================
// GŁÓWNA FUNKCJA EA
//==================================================

void OnTick()
{
   if(!IsTradeAllowed())
      return;


   if(!IsMarketOpen())
      return;


   // Trailing działa na każdym ticku.

   if(TrailingStop > 0.0)
      ApplyTrailingStop();


   if(!IsTimeToTrade())
      return;


   // Sygnały tylko raz na nowej świecy.

   if(!IsNewBar(true))
      return;


   //==================================================
   // POBRANIE ŚREDNICH SYGNAŁOWYCH
   //==================================================

   if(
      CopyBuffer(
         FastHandle,
         0,
         0,
         3,
         FastBuffer
      ) < 3
   )
   {
      Print(
         "Brak danych szybkiej średniej sygnałowej."
      );

      return;
   }


   if(
      CopyBuffer(
         SlowHandle,
         0,
         InpSlowMAShift,
         3,
         SlowBuffer
      ) < 3
   )
   {
      Print(
         "Brak danych wolnej średniej sygnałowej."
      );

      return;
   }


   //==================================================
   // POBRANIE ŚREDNICH TRENDOWYCH
   //==================================================

   if(
      CopyBuffer(
         TrendFastHandle,
         0,
         0,
         3,
         TrendFastBuffer
      ) < 3
   )
   {
      Print(
         "Brak danych szybkiej średniej trendowej."
      );

      return;
   }


   if(
      CopyBuffer(
         TrendSlowHandle,
         0,
         0,
         3,
         TrendSlowBuffer
      ) < 3
   )
   {
      Print(
         "Brak danych wolnej średniej trendowej."
      );

      return;
   }


   //==================================================
   // PRZECIĘCIA ŚREDNICH SYGNAŁOWYCH
   //==================================================

   bool crossUp =
      FastBuffer[1] > SlowBuffer[1] &&
      FastBuffer[2] <= SlowBuffer[2];


   bool crossDown =
      FastBuffer[1] < SlowBuffer[1] &&
      FastBuffer[2] >= SlowBuffer[2];


   //==================================================
   // KIERUNEK TRENDU
   //==================================================

   bool trendBuy =
      TrendFastBuffer[1] >
      TrendSlowBuffer[1];


   bool trendSell =
      TrendFastBuffer[1] <
      TrendSlowBuffer[1];


   //==================================================
   // SYGNAŁ BUY
   //==================================================

   if(crossUp && trendBuy)
   {
      if(!IsTrendMoveEntryAllowed(true))
         return;


      OpenTrade(
         ORDER_TYPE_BUY
      );
   }


   //==================================================
   // SYGNAŁ SELL
   //==================================================

   if(crossDown && trendSell)
   {
      if(!IsTrendMoveEntryAllowed(false))
         return;


      OpenTrade(
         ORDER_TYPE_SELL
      );
   }
}


//==================================================
// NAJWYŻSZE HIGH
//==================================================

bool GetHighestHigh(
   const int lookback,
   double &highest
)
{
   if(lookback < 1)
      return false;


   if(
      Bars(
         Symbol(),
         Period()
      ) < lookback + 5
   )
   {
      return false;
   }


   double highs[];

   ArraySetAsSeries(
      highs,
      true
   );


   int copied = CopyHigh(
      Symbol(),
      Period(),
      1,
      lookback,
      highs
   );


   if(copied < lookback)
      return false;


   int highestIndex = ArrayMaximum(
      highs,
      0,
      lookback
   );


   if(highestIndex < 0)
      return false;


   highest =
      highs[highestIndex];


   return true;
}


//==================================================
// NAJNIŻSZE LOW
//==================================================

bool GetLowestLow(
   const int lookback,
   double &lowest
)
{
   if(lookback < 1)
      return false;


   if(
      Bars(
         Symbol(),
         Period()
      ) < lookback + 5
   )
   {
      return false;
   }


   double lows[];

   ArraySetAsSeries(
      lows,
      true
   );


   int copied = CopyLow(
      Symbol(),
      Period(),
      1,
      lookback,
      lows
   );


   if(copied < lookback)
      return false;


   int lowestIndex = ArrayMinimum(
      lows,
      0,
      lookback
   );


   if(lowestIndex < 0)
      return false;


   lowest =
      lows[lowestIndex];


   return true;
}


//==================================================
// LICZBA ŚWIEC W AKTUALNYM TRENDZIE
//==================================================

int GetTrendRunBars(
   bool wantBuyTrend,
   int maxLookback
)
{
   int availableBars = Bars(
      Symbol(),
      Period()
   );


   int limit = MathMin(
      maxLookback,
      availableBars - 2
   );


   if(limit < 1)
      return 0;


   double trendFastValues[];
   double trendSlowValues[];


   ArraySetAsSeries(
      trendFastValues,
      true
   );

   ArraySetAsSeries(
      trendSlowValues,
      true
   );


   if(
      CopyBuffer(
         TrendFastHandle,
         0,
         1,
         limit,
         trendFastValues
      ) < limit
   )
   {
      return 0;
   }


   if(
      CopyBuffer(
         TrendSlowHandle,
         0,
         1,
         limit,
         trendSlowValues
      ) < limit
   )
   {
      return 0;
   }


   int count = 0;


   for(
      int index = 0;
      index < limit;
      index++
   )
   {
      if(wantBuyTrend)
      {
         if(
            trendFastValues[index] >
            trendSlowValues[index]
         )
         {
            count++;
         }
         else
         {
            break;
         }
      }
      else
      {
         if(
            trendFastValues[index] <
            trendSlowValues[index]
         )
         {
            count++;
         }
         else
         {
            break;
         }
      }
   }


   return count;
}


//==================================================
// OTWIERANIE POZYCJI
//==================================================

void OpenTrade(ENUM_ORDER_TYPE type)
{
   bool wantBuy =
      type == ORDER_TYPE_BUY;


   //==================================================
   // TYLKO JEDNA POZYCJA NARAZ
   //==================================================

   if(!IsSingleOpenPositionAllowed())
      return;


   //==================================================
   // LIMIT WEJŚĆ W TRENDZIE
   //==================================================

   if(!IsTrendPositionLimitAllowed(wantBuy))
      return;


   //==================================================
   // AKTUALNE CENY
   //==================================================

   double ask = SymbolInfoDouble(
      Symbol(),
      SYMBOL_ASK
   );

   double bid = SymbolInfoDouble(
      Symbol(),
      SYMBOL_BID
   );

   double point = SymbolInfoDouble(
      Symbol(),
      SYMBOL_POINT
   );

   double pipSize =
      PipSize(Symbol());


   if(
      ask <= 0.0 ||
      bid <= 0.0 ||
      point <= 0.0 ||
      pipSize <= 0.0
   )
   {
      PrintFormat(
         "SKIP %s: nie można pobrać aktualnej ceny.",
         wantBuy ? "BUY" : "SELL"
      );

      return;
   }


   double price =
      wantBuy ? ask : bid;


   double minimumStopDistance =
      (double)SymbolInfoInteger(
         Symbol(),
         SYMBOL_TRADE_STOPS_LEVEL
      )
      *
      point;


   //==================================================
   // ROOM DO SZCZYTU LUB DOŁKA
   //==================================================

   int roomBarsUsed = GetTrendRunBars(
      wantBuy,
      InpRoomLookbackBars
   );


   if(roomBarsUsed < 1)
   {
      PrintFormat(
         "SKIP %s: brak świec aktualnego trendu dla ROOM.",
         wantBuy ? "BUY" : "SELL"
      );

      return;
   }


   double requiredRoom =
      PipsToDouble(
         InpMinRoomPips
      );


   double roomExtreme = 0.0;


   if(wantBuy)
   {
      double highest = 0.0;


      if(
         !GetHighestHigh(
            roomBarsUsed,
            highest
         )
      )
      {
         Print(
            "SKIP BUY: nie można wyliczyć wcześniejszego HIGH."
         );

         return;
      }


      roomExtreme = highest;


      double room =
         roomExtreme - ask;

      double roomPips =
         room / pipSize;


      if(room < requiredRoom)
      {
         PrintFormat(
            "SKIP BUY: za mało miejsca do HIGH. ROOM=%.1f pips, wymagane=%.1f.",
            roomPips,
            InpMinRoomPips
         );

         return;
      }
   }
   else
   {
      double lowest = 0.0;


      if(
         !GetLowestLow(
            roomBarsUsed,
            lowest
         )
      )
      {
         Print(
            "SKIP SELL: nie można wyliczyć wcześniejszego LOW."
         );

         return;
      }


      roomExtreme = lowest;


      double room =
         bid - roomExtreme;

      double roomPips =
         room / pipSize;


      if(room < requiredRoom)
      {
         PrintFormat(
            "SKIP SELL: za mało miejsca do LOW. ROOM=%.1f pips, wymagane=%.1f.",
            roomPips,
            InpMinRoomPips
         );

         return;
      }
   }


   //==================================================
   // WOLNA ŚREDNIA TRENDOWA DLA STOP LOSS
   //==================================================

   double trendSlowValues[];

   ArraySetAsSeries(
      trendSlowValues,
      true
   );


   if(
      CopyBuffer(
         TrendSlowHandle,
         0,
         0,
         2,
         trendSlowValues
      ) < 2
   )
   {
      PrintFormat(
         "SKIP %s: nie można pobrać wolnej średniej trendowej.",
         wantBuy ? "BUY" : "SELL"
      );

      return;
   }


   // Ostatnia zamknięta świeca.

   double trendSlowMA =
      trendSlowValues[1];


   if(trendSlowMA <= 0.0)
   {
      Print(
         "Nieprawidłowa wartość wolnej średniej trendowej."
      );

      return;
   }


   //==================================================
   // STOP LOSS NA ŚREDNIEJ
   //==================================================

   double slBuffer =
      PipsToDouble(
         InpSLBufferPips
      );


   double sl = 0.0;


   if(wantBuy)
   {
      // BUY: SL pod wolną średnią trendową.

      sl =
         trendSlowMA -
         slBuffer;


      if(sl >= bid)
      {
         PrintFormat(
            "SKIP BUY: średnia %d nie znajduje się pod ceną. Cena=%.5f, średnia=%.5f, SL=%.5f.",
            InpTrendSlowMABars,
            price,
            trendSlowMA,
            sl
         );

         return;
      }


      double maximumAllowedSL =
         bid -
         minimumStopDistance;


      if(
         minimumStopDistance > 0.0 &&
         sl > maximumAllowedSL
      )
      {
         sl =
            maximumAllowedSL;
      }
   }
   else
   {
      // SELL: SL nad wolną średnią trendową.

      sl =
         trendSlowMA +
         slBuffer;


      if(sl <= ask)
      {
         PrintFormat(
            "SKIP SELL: średnia %d nie znajduje się nad ceną. Cena=%.5f, średnia=%.5f, SL=%.5f.",
            InpTrendSlowMABars,
            price,
            trendSlowMA,
            sl
         );

         return;
      }


      double minimumAllowedSL =
         ask +
         minimumStopDistance;


      if(
         minimumStopDistance > 0.0 &&
         sl < minimumAllowedSL
      )
      {
         sl =
            minimumAllowedSL;
      }
   }


   //==================================================
   // ODLEGŁOŚĆ STOP LOSS
   //==================================================

   double slDistancePips = 0.0;


   if(wantBuy)
   {
      slDistancePips =
         (
            price -
            sl
         )
         /
         pipSize;
   }
   else
   {
      slDistancePips =
         (
            sl -
            price
         )
         /
         pipSize;
   }


   if(slDistancePips <= 0.0)
   {
      PrintFormat(
         "SKIP %s: SL znajduje się po złej stronie ceny.",
         wantBuy ? "BUY" : "SELL"
      );

      return;
   }


   if(
      InpMaxSLPips > 0.0 &&
      slDistancePips > InpMaxSLPips
   )
   {
      PrintFormat(
         "SKIP %s: SL za daleko. Odległość=%.1f pips, limit=%.1f.",
         wantBuy ? "BUY" : "SELL",
         slDistancePips,
         InpMaxSLPips
      );

      return;
   }


   //==================================================
   // TAKE PROFIT
   //==================================================

   double tp = 0.0;


   if(InpTPMode == TP_MODE_OFF)
   {
      tp = 0.0;
   }
   else if(InpTPMode == TP_MODE_FIXED)
   {
      if(InpTakeProfitPips > 0.0)
      {
         if(wantBuy)
         {
            tp =
               price +
               TakeProfit;
         }
         else
         {
            tp =
               price -
               TakeProfit;
         }
      }
   }
   else if(InpTPMode == TP_MODE_DYNAMIC_EXTREME)
   {
      double tpBuffer =
         PipsToDouble(
            InpTPBufferPips
         );


      if(wantBuy)
      {
         tp =
            roomExtreme -
            tpBuffer;


         if(
            tp <=
            price +
            minimumStopDistance
         )
         {
            Print(
               "SKIP BUY: dynamiczny TP jest za blisko."
            );

            return;
         }
      }
      else
      {
         tp =
            roomExtreme +
            tpBuffer;


         if(
            tp >=
            price -
            minimumStopDistance
         )
         {
            Print(
               "SKIP SELL: dynamiczny TP jest za blisko."
            );

            return;
         }
      }
   }


   //==================================================
   // DOSTOSOWANIE TP DO MINIMALNEGO DYSTANSU
   //==================================================

   if(
      tp > 0.0 &&
      minimumStopDistance > 0.0
   )
   {
      if(wantBuy)
      {
         double minimumTP =
            ask +
            minimumStopDistance;


         if(tp < minimumTP)
            tp = minimumTP;
      }
      else
      {
         double maximumTP =
            bid -
            minimumStopDistance;


         if(tp > maximumTP)
            tp = maximumTP;
      }
   }


   //==================================================
   // TP MUSI BYĆ WIĘKSZY OD SL
   //==================================================

   if(
      InpRequireTPGreaterThanSL &&
      tp > 0.0
   )
   {
      double tpDistancePips = 0.0;


      if(wantBuy)
      {
         tpDistancePips =
            (
               tp -
               price
            )
            /
            pipSize;
      }
      else
      {
         tpDistancePips =
            (
               price -
               tp
            )
            /
            pipSize;
      }


      if(tpDistancePips <= slDistancePips)
      {
         PrintFormat(
            "SKIP %s: TP nie jest większy od SL. TP=%.1f pips, SL=%.1f pips.",
            wantBuy ? "BUY" : "SELL",
            tpDistancePips,
            slDistancePips
         );

         return;
      }
   }


   //==================================================
   // NORMALIZACJA
   //==================================================

   price = NormalizeDouble(
      price,
      Digits()
   );

   sl = NormalizeDouble(
      sl,
      Digits()
   );


   if(tp != 0.0)
   {
      tp = NormalizeDouble(
         tp,
         Digits()
      );
   }


   PrintFormat(
      "OPEN %s: cena=%.5f, SL=%.5f na MA %d, średnia=%.5f, SL dystans=%.1f pips, TP=%.5f.",
      wantBuy ? "BUY" : "SELL",
      price,
      sl,
      InpTrendSlowMABars,
      trendSlowMA,
      slDistancePips,
      tp
   );


   //==================================================
   // OTWARCIE POZYCJI
   //==================================================

   ResetLastError();


   if(
      !Trade.PositionOpen(
         Symbol(),
         type,
         InpOrderSize,
         price,
         sl,
         tp,
         InpTradeComment
      )
   )
   {
      PrintFormat(
         "Błąd otwarcia %s. Cena=%f, SL=%f, TP=%f, błąd=%d, retcode=%u, opis=%s.",
         wantBuy ? "BUY" : "SELL",
         price,
         sl,
         tp,
         GetLastError(),
         Trade.ResultRetcode(),
         Trade.ResultRetcodeDescription()
      );
   }
   else
   {
      PrintFormat(
         "OTWARTO %s. SL ustawiony na średniej %d z buforem %.1f pips.",
         wantBuy ? "BUY" : "SELL",
         InpTrendSlowMABars,
         InpSLBufferPips
      );
   }
}


//==================================================
// TRAILING STOP
//==================================================

void ApplyTrailingStop()
{
   double ask = SymbolInfoDouble(
      Symbol(),
      SYMBOL_ASK
   );

   double bid = SymbolInfoDouble(
      Symbol(),
      SYMBOL_BID
   );


   double buyTrailingStopPrice = NormalizeDouble(
      ask -
      TrailingStop,
      Digits()
   );


   double sellTrailingStopPrice = NormalizeDouble(
      bid +
      TrailingStop,
      Digits()
   );


   for(
      int index = PositionsTotal() - 1;
      index >= 0;
      index--
   )
   {
      ulong ticket =
         PositionGetTicket(index);


      if(ticket == 0)
         continue;


      if(!Position.SelectByTicket(ticket))
         continue;


      if(Position.Symbol() != Symbol())
         continue;


      if(Position.Magic() != InpMagic)
         continue;


      // Trailing BUY

      if(
         Position.PositionType() == POSITION_TYPE_BUY &&
         buyTrailingStopPrice > Position.PriceOpen() &&
         (
            Position.StopLoss() == 0.0 ||
            buyTrailingStopPrice > Position.StopLoss()
         )
      )
      {
         ResetLastError();


         if(
            !Trade.PositionModify(
               ticket,
               buyTrailingStopPrice,
               Position.TakeProfit()
            )
         )
         {
            PrintFormat(
               "Błąd trailing BUY. Ticket=%I64u, retcode=%u, opis=%s.",
               ticket,
               Trade.ResultRetcode(),
               Trade.ResultRetcodeDescription()
            );
         }
      }


      // Trailing SELL

      if(
         Position.PositionType() == POSITION_TYPE_SELL &&
         sellTrailingStopPrice < Position.PriceOpen() &&
         (
            Position.StopLoss() == 0.0 ||
            sellTrailingStopPrice < Position.StopLoss()
         )
      )
      {
         ResetLastError();


         if(
            !Trade.PositionModify(
               ticket,
               sellTrailingStopPrice,
               Position.TakeProfit()
            )
         )
         {
            PrintFormat(
               "Błąd trailing SELL. Ticket=%I64u, retcode=%u, opis=%s.",
               ticket,
               Trade.ResultRetcode(),
               Trade.ResultRetcodeDescription()
            );
         }
      }
   }
}
