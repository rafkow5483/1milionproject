bool IsTimeToTrade()
{
   MqlDateTime currentDateTime;
   TimeToStruct(
      TimeCurrent(),
      currentDateTime
   );

   int currentMinutes =
      currentDateTime.hour * 60 +
      currentDateTime.min;

   int startTime1 =
      startHour1 * 60 +
      startMinute1;

   int endTime1 =
      endHour1 * 60 +
      endMinute1;

   int startTime2 =
      startHour2 * 60 +
      startMinute2;

   int endTime2 =
      endHour2 * 60 +
      endMinute2;


   bool inPeriod1 =
      enableTimePeriod1 &&
      currentMinutes >= startTime1 &&
      currentMinutes <= endTime1;


   bool inPeriod2 =
      enableTimePeriod2 &&
      currentMinutes >= startTime2 &&
      currentMinutes <= endTime2;


   return inPeriod1 || inPeriod2;
}


//==================================================
// ROZMIAR PIPSA
//==================================================

double PipSize()
{
   return PipSize(Symbol());
}


double PipSize(string symbol)
{
   double point = SymbolInfoDouble(
      symbol,
      SYMBOL_POINT
   );

   int digits = (int)SymbolInfoInteger(
      symbol,
      SYMBOL_DIGITS
   );


   if((digits % 2) == 1)
      return point * 10.0;


   return point;
}


double PipsToDouble(double pips)
{
   return pips * PipSize(Symbol());
}


double PipsToDouble(
   double pips,
   string symbol
)
{
   return pips * PipSize(symbol);
}


