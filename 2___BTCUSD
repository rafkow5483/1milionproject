bool IsNewBar(bool firstCall)
{
   static datetime previousBarTime = 0;

   datetime currentBarTime = iTime(
      Symbol(),
      Period(),
      0
   );


   if(!firstCall)
      return false;


   if(currentBarTime <= 0)
      return false;


   if(previousBarTime != currentBarTime)
   {
      previousBarTime = currentBarTime;
      return true;
   }


   return false;
}


