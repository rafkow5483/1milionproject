//==================================================
// MAKSYMALNY RUCH OD OSTATNIEGO PRZECIĘCIA TRENDU
//==================================================

bool GetTrendMoveSinceLastCross(
   const bool wantBuyTrend,
   double &crossPrice,
   double &maxMovePips,
   int &crossShift
)
{
   crossPrice  = 0.0;
   maxMovePips = 0.0;
   crossShift  = -1;


   int availableBars = Bars(
      Symbol(),
      Period()
   );

   int fastCalculated = BarsCalculated(
      TrendFastHandle
   );

   int slowCalculated = BarsCalculated(
      TrendSlowHandle
   );


   int usableBars = MathMin(
      availableBars,
      MathMin(
         fastCalculated,
         slowCalculated
      )
   );


   int searchLimit = MathMin(
      InpTrendCrossSearchBars,
      usableBars - 2
   );


   if(searchLimit < 2)
   {
      Print(
         "Za mało historii do znalezienia przecięcia trendowego."
      );

      return false;
   }


   int valuesNeeded =
      searchLimit + 2;


   double trendFastHistory[];
   double trendSlowHistory[];


   ArraySetAsSeries(
      trendFastHistory,
      true
   );

   ArraySetAsSeries(
      trendSlowHistory,
      true
   );


   if(
      CopyBuffer(
         TrendFastHandle,
         0,
         0,
         valuesNeeded,
         trendFastHistory
      ) < valuesNeeded
   )
   {
      Print(
         "Nie można pobrać historii szybkiej średniej trendowej."
      );

      return false;
   }


   if(
      CopyBuffer(
         TrendSlowHandle,
         0,
         0,
         valuesNeeded,
         trendSlowHistory
      ) < valuesNeeded
   )
   {
      Print(
         "Nie można pobrać historii wolnej średniej trendowej."
      );

      return false;
   }


   // Szukanie ostatniego przecięcia zgodnego
   // z obecnym kierunkiem trendu.

   for(
      int shift = 1;
      shift <= searchLimit;
      shift++
   )
   {
      bool trendCross = false;


      if(wantBuyTrend)
      {
         trendCross =
            trendFastHistory[shift] >
            trendSlowHistory[shift]
            &&
            trendFastHistory[shift + 1] <=
            trendSlowHistory[shift + 1];
      }
      else
      {
         trendCross =
            trendFastHistory[shift] <
            trendSlowHistory[shift]
            &&
            trendFastHistory[shift + 1] >=
            trendSlowHistory[shift + 1];
      }


      if(trendCross)
      {
         crossShift = shift;
         break;
      }
   }


   if(crossShift < 0)
   {
      PrintFormat(
         "Nie znaleziono przecięcia trendowego w ostatnich %d świecach.",
         InpTrendCrossSearchBars
      );

      return false;
   }


   crossPrice = iClose(
      Symbol(),
      Period(),
      crossShift
   );


   if(crossPrice <= 0.0)
   {
      Print(
         "Nie można pobrać ceny przecięcia trendowego."
      );

      return false;
   }


   double pipSize =
      PipSize(Symbol());


   if(pipSize <= 0.0)
      return false;


   // Nie uwzględniamy HIGH/LOW świecy przecięcia.
   // Liczymy ruch od jej zamknięcia.

   int barsAfterCross =
      crossShift;


   if(barsAfterCross < 1)
      barsAfterCross = 1;


   if(wantBuyTrend)
   {
      double highs[];

      ArraySetAsSeries(
         highs,
         true
      );


      int copied = CopyHigh(
         Symbol(),
         Period(),
         0,
         barsAfterCross,
         highs
      );


      if(copied < barsAfterCross)
         return false;


      int highestIndex = ArrayMaximum(
         highs,
         0,
         copied
      );


      if(highestIndex < 0)
         return false;


      double highestPrice =
         highs[highestIndex];


      maxMovePips = MathMax(
         0.0,
         (
            highestPrice -
            crossPrice
         )
         /
         pipSize
      );
   }
   else
   {
      double lows[];

      ArraySetAsSeries(
         lows,
         true
      );


      int copied = CopyLow(
         Symbol(),
         Period(),
         0,
         barsAfterCross,
         lows
      );


      if(copied < barsAfterCross)
         return false;


      int lowestIndex = ArrayMinimum(
         lows,
         0,
         copied
      );


      if(lowestIndex < 0)
         return false;


      double lowestPrice =
         lows[lowestIndex];


      maxMovePips = MathMax(
         0.0,
         (
            crossPrice -
            lowestPrice
         )
         /
         pipSize
      );
   }


   return true;
}


