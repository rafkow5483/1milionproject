int OnInit()
{
   TakeProfit =
      PipsToDouble(
         InpTakeProfitPips
      );

   TrailingStop =
      PipsToDouble(
         InpTrailingStopPips
      );


   Trade.SetExpertMagicNumber(
      InpMagic
   );


   // Średnia sygnałowa szybka

   FastHandle = iMA(
      Symbol(),
      Period(),
      InpFastMABars,
      0,
      InpFastMAMethod,
      InpFastMAAppliedPrice
   );

   ArraySetAsSeries(
      FastBuffer,
      true
   );


   // Średnia sygnałowa wolna

   SlowHandle = iMA(
      Symbol(),
      Period(),
      InpSlowMABars,
      0,
      InpSlowMAMethod,
      InpSlowMAAppliedPrice
   );

   ArraySetAsSeries(
      SlowBuffer,
      true
   );


   // Średnia trendowa szybka

   TrendFastHandle = iMA(
      Symbol(),
      Period(),
      InpTrendFastMABars,
      0,
      InpTrendFastMAMethod,
      InpTrendFastMAAppliedPrice
   );

   ArraySetAsSeries(
      TrendFastBuffer,
      true
   );


   // Średnia trendowa wolna

   TrendSlowHandle = iMA(
      Symbol(),
      Period(),
      InpTrendSlowMABars,
      0,
      InpTrendSlowMAMethod,
      InpTrendSlowMAAppliedPrice
   );

   ArraySetAsSeries(
      TrendSlowBuffer,
      true
   );


   if(
      FastHandle == INVALID_HANDLE ||
      SlowHandle == INVALID_HANDLE
   )
   {
      Print(
         "Błąd tworzenia średnich sygnałowych."
      );

      return INIT_FAILED;
   }


   if(
      TrendFastHandle == INVALID_HANDLE ||
      TrendSlowHandle == INVALID_HANDLE
   )
   {
      Print(
         "Błąd tworzenia średnich trendowych."
      );

      return INIT_FAILED;
   }


   // Zapobiega otwarciu pozycji natychmiast po uruchomieniu EA.

   IsNewBar(true);


   return INIT_SUCCEEDED;
}


