bool GetTrendMoveSinceLastCross(
   const bool wantBuyTrend,
   double &crossPrice,
   double &maxMovePips,
   int &crossShift
)
{
   crossPrice  = 0.0;
   maxMovePips = 0.0;
   crossShift  = -1;

   int availableBars = Bars(
      Symbol(),
      Period()
   );

   int fastCalculated = BarsCalculated(
      TrendFastHandle
   );

   int slowCalculated = BarsCalculated(
      TrendSlowHandle
   );

   int usableBars = MathMin(
      availableBars,
      MathMin(
         fastCalculated,
         slowCalculated
      )
   );

   int searchLimit = MathMin(
      InpTrendCrossSearchBars,
      usableBars - 2
   );

   if(searchLimit < 2)
   {
      Print(
         "Za mało historii do znalezienia przecięcia trendowego."
      );

      return false;
   }

   int valuesNeeded =
      searchLimit + 2;

   double trendFastHistory[];
   double trendSlowHistory[];

   ArraySetAsSeries(
      trendFastHistory,
      true
   );

   ArraySetAsSeries(
      trendSlowHistory,
      true
   );

   if(
      CopyBuffer(
         TrendFastHandle,
         0,
         0,
         valuesNeeded,
         trendFastHistory
      ) < valuesNeeded
   )
   {
      Print(
         "Nie można pobrać historii szybkiej średniej trendowej."
      );

      return false;
   }

   if(
      CopyBuffer(
         TrendSlowHandle,
         0,
         0,
         valuesNeeded,
         trendSlowHistory
      ) < valuesNeeded
   )
   {
      Print(
         "Nie można pobrać historii wolnej średniej trendowej."
      );

      return false;
   }

   for(
      int shift = 1;
      shift <= searchLimit;
      shift++
   )
   {
      bool trendCross = false;

      if(wantBuyTrend)
      {
         trendCross =
            trendFastHistory[shift] >
            trendSlowHistory[shift]
            &&
            trendFastHistory[shift + 1] <=
            trendSlowHistory[shift + 1];
      }
      else
      {
         trendCross =
            trendFastHistory[shift] <
            trendSlowHistory[shift]
            &&
            trendFastHistory[shift + 1] >=
            trendSlowHistory[shift + 1];
      }

      if(trendCross)
      {
         crossShift = shift;
         break;
      }
   }

   if(crossShift < 0)
   {
      PrintFormat(
         "Nie znaleziono przecięcia trendowego w ostatnich %d świecach.",
         InpTrendCrossSearchBars
      );

      return false;
   }

   crossPrice = iClose(
      Symbol(),
      Period(),
      crossShift
   );

   if(crossPrice <= 0.0)
   {
      Print(
         "Nie można pobrać ceny przecięcia trendowego."
      );

      return false;
   }

   double pipSize =
      PipSize(Symbol());

   if(pipSize <= 0.0)
      return false;

   int barsAfterCross =
      crossShift;

   if(barsAfterCross < 1)
      barsAfterCross = 1;

   if(wantBuyTrend)
   {
      double highs[];

      ArraySetAsSeries(
         highs,
         true
      );

      int copied = CopyHigh(
         Symbol(),
         Period(),
         0,
         barsAfterCross,
         highs
      );

      if(copied < barsAfterCross)
         return false;

      int highestIndex = ArrayMaximum(
         highs,
         0,
         copied
      );

      if(highestIndex < 0)
         return false;

      double highestPrice =
         highs[highestIndex];

      maxMovePips = MathMax(
         0.0,
         (
            highestPrice -
            crossPrice
         )
         /
         pipSize
      );
   }
   else
   {
      double lows[];

      ArraySetAsSeries(
         lows,
         true
      );

      int copied = CopyLow(
         Symbol(),
         Period(),
         0,
         barsAfterCross,
         lows
      );

      if(copied < barsAfterCross)
         return false;

      int lowestIndex = ArrayMinimum(
         lows,
         0,
         copied
      );

      if(lowestIndex < 0)
         return false;

      double lowestPrice =
         lows[lowestIndex];

      maxMovePips = MathMax(
         0.0,
         (
            crossPrice -
            lowestPrice
         )
         /
         pipSize
      );
   }

   return true;
}

bool IsTrendMoveEntryAllowed(
   const bool wantBuyTrend
)
{
   if(
      !InpUseTrendMoveBlock ||
      InpMaxTrendMovePips <= 0.0
   )
   {
      return true;
   }

   double crossPrice  = 0.0;
   double maxMovePips = 0.0;
   int crossShift     = -1;

   if(
      !GetTrendMoveSinceLastCross(
         wantBuyTrend,
         crossPrice,
         maxMovePips,
         crossShift
      )
   )
   {
      PrintFormat(
         "SKIP %s: nie można sprawdzić ruchu od przecięcia trendowego.",
         wantBuyTrend ? "BUY" : "SELL"
      );

      return false;
   }

   PrintFormat(
      "TREND %s: przecięcie=%.5f, maksymalny ruch=%.1f pips, limit=%.1f pips.",
      wantBuyTrend ? "BUY" : "SELL",
      crossPrice,
      maxMovePips,
      InpMaxTrendMovePips
   );

   if(maxMovePips >= InpMaxTrendMovePips)
   {
      PrintFormat(
         "SKIP %s: trend osiągnął %.1f pips. Limit=%.1f. Blokada do następnego przecięcia trendowego.",
         wantBuyTrend ? "BUY" : "SELL",
         maxMovePips,
         InpMaxTrendMovePips
      );

      return false;
   }

   return true;
}

bool HasOpenPositionForThisEA()
{
   for(
      int index = PositionsTotal() - 1;
      index >= 0;
      index--
   )
   {
      ulong ticket =
         PositionGetTicket(index);

      if(ticket == 0)
         continue;

      if(!PositionSelectByTicket(ticket))
         continue;

      string positionSymbol = PositionGetString(
         POSITION_SYMBOL
      );

      long positionMagic = PositionGetInteger(
         POSITION_MAGIC
      );

      if(positionSymbol != Symbol())
         continue;

      if(positionMagic != (long)InpMagic)
         continue;

      return true;
   }

   return false;
}

bool IsSingleOpenPositionAllowed()
{
   if(!InpOnlyOneOpenPosition)
      return true;

   if(HasOpenPositionForThisEA())
   {
      Print(
         "SKIP: istnieje już otwarta pozycja tego EA. Kolejna może zostać otwarta po jej zamknięciu."
      );

      return false;
   }

   return true;
}

bool IsDirectionCooldownAllowed(
   const ENUM_ORDER_TYPE orderType
)
{
   if(
      !InpUseDirectionCooldown ||
      InpDirectionCooldownMinutes <= 0
   )
   {
      return true;
   }

   bool wantBuy =
      orderType == ORDER_TYPE_BUY;

   datetime currentTime =
      TimeCurrent();

   datetime cooldownStart =
      currentTime -
      (datetime)(InpDirectionCooldownMinutes * 60);

   ResetLastError();

   if(
      !HistorySelect(
         cooldownStart,
         currentTime
      )
   )
   {
      PrintFormat(
         "SKIP %s: nie można sprawdzić cooldownu. Błąd=%d.",
         wantBuy ? "BUY" : "SELL",
         GetLastError()
      );

      return false;
   }

   datetime lastEntryTime = 0;
   int totalDeals = HistoryDealsTotal();

   for(
      int index = totalDeals - 1;
      index >= 0;
      index--
   )
   {
      ulong dealTicket =
         HistoryDealGetTicket(index);

      if(dealTicket == 0)
         continue;

      string dealSymbol =
         HistoryDealGetString(
            dealTicket,
            DEAL_SYMBOL
         );

      long dealMagic =
         HistoryDealGetInteger(
            dealTicket,
            DEAL_MAGIC
         );

      if(dealSymbol != Symbol())
         continue;

      if(dealMagic != (long)InpMagic)
         continue;

      ENUM_DEAL_ENTRY dealEntry =
         (ENUM_DEAL_ENTRY)HistoryDealGetInteger(
            dealTicket,
            DEAL_ENTRY
         );

      if(
         dealEntry != DEAL_ENTRY_IN &&
         dealEntry != DEAL_ENTRY_INOUT
      )
      {
         continue;
      }

      ENUM_DEAL_TYPE dealType =
         (ENUM_DEAL_TYPE)HistoryDealGetInteger(
            dealTicket,
            DEAL_TYPE
         );

      bool sameDirection =
         (
            wantBuy &&
            dealType == DEAL_TYPE_BUY
         )
         ||
         (
            !wantBuy &&
            dealType == DEAL_TYPE_SELL
         );

      if(!sameDirection)
         continue;

      datetime dealTime =
         (datetime)HistoryDealGetInteger(
            dealTicket,
            DEAL_TIME
         );

      if(dealTime > lastEntryTime)
         lastEntryTime = dealTime;
   }

   if(lastEntryTime <= 0)
      return true;

   int elapsedSeconds =
      (int)(currentTime - lastEntryTime);

   int cooldownSeconds =
      InpDirectionCooldownMinutes * 60;

   if(elapsedSeconds < cooldownSeconds)
   {
      int remainingSeconds =
         cooldownSeconds - elapsedSeconds;

      int remainingMinutes =
         (remainingSeconds + 59) / 60;

      PrintFormat(
         "SKIP %s: cooldown po ostatnim %s nadal trwa. Ostatnie otwarcie=%s, pozostało około %d min.",
         wantBuy ? "BUY" : "SELL",
         wantBuy ? "BUY" : "SELL",
         TimeToString(
            lastEntryTime,
            TIME_DATE | TIME_MINUTES | TIME_SECONDS
         ),
         remainingMinutes
      );

      return false;
   }

   return true;
}

int CountEntriesSinceTrendCross(
   const bool wantBuyTrend,
   datetime &crossTime,
   int &crossShift
)
{
   crossTime  = 0;
   crossShift = -1;

   double crossPrice  = 0.0;
   double maxMovePips = 0.0;

   if(
      !GetTrendMoveSinceLastCross(
         wantBuyTrend,
         crossPrice,
         maxMovePips,
         crossShift
      )
   )
   {
      return -1;
   }

   crossTime = iTime(
      Symbol(),
      Period(),
      crossShift
   );

   if(crossTime <= 0)
      return -1;

   ResetLastError();

   if(
      !HistorySelect(
         crossTime,
         TimeCurrent()
      )
   )
   {
      PrintFormat(
         "HistorySelect nie powiódł się. Błąd=%d.",
         GetLastError()
      );

      return -1;
   }

   int entries    = 0;
   int totalDeals = HistoryDealsTotal();

   for(
      int index = 0;
      index < totalDeals;
      index++
   )
   {
      ulong dealTicket =
         HistoryDealGetTicket(index);

      if(dealTicket == 0)
         continue;

      string dealSymbol = HistoryDealGetString(
         dealTicket,
         DEAL_SYMBOL
      );

      long dealMagic = HistoryDealGetInteger(
         dealTicket,
         DEAL_MAGIC
      );

      if(dealSymbol != Symbol())
         continue;

      if(dealMagic != (long)InpMagic)
         continue;

      ENUM_DEAL_ENTRY dealEntry =
         (ENUM_DEAL_ENTRY)HistoryDealGetInteger(
            dealTicket,
            DEAL_ENTRY
         );

      if(
         dealEntry != DEAL_ENTRY_IN &&
         dealEntry != DEAL_ENTRY_INOUT
      )
      {
         continue;
      }

      ENUM_DEAL_TYPE dealType =
         (ENUM_DEAL_TYPE)HistoryDealGetInteger(
            dealTicket,
            DEAL_TYPE
         );

      if(
         wantBuyTrend &&
         dealType == DEAL_TYPE_BUY
      )
      {
         entries++;
      }
      else if(
         !wantBuyTrend &&
         dealType == DEAL_TYPE_SELL
      )
      {
         entries++;
      }
   }

   return entries;
}

bool IsTrendPositionLimitAllowed(
   const bool wantBuyTrend
)
{
   if(InpMaxPositionsPerTrend <= 0)
      return true;

   datetime crossTime = 0;
   int crossShift     = -1;

   int entries = CountEntriesSinceTrendCross(
      wantBuyTrend,
      crossTime,
      crossShift
   );

   if(entries < 0)
   {
      PrintFormat(
         "SKIP %s: nie można sprawdzić liczby wejść w trendzie.",
         wantBuyTrend ? "BUY" : "SELL"
      );

      return false;
   }

   PrintFormat(
      "TREND %s: wykorzystane wejścia=%d/%d, początek=%s.",
      wantBuyTrend ? "BUY" : "SELL",
      entries,
      InpMaxPositionsPerTrend,
      TimeToString(
         crossTime,
         TIME_DATE | TIME_MINUTES
      )
   );

   if(entries >= InpMaxPositionsPerTrend)
   {
      PrintFormat(
         "SKIP %s: wykorzystano już %d wejścia w tym trendzie.",
         wantBuyTrend ? "BUY" : "SELL",
         InpMaxPositionsPerTrend
      );

      return false;
   }

   return true;
}

void OnTick()
{
   if(!IsTradeAllowed())
      return;

   if(!IsMarketOpen())
      return;

   if(InpUseMATrailingStop)
      ApplyTrailingStop();

   if(!IsTimeToTrade())
      return;

   if(!IsNewBar(true))
      return;

   if(
      CopyBuffer(
         FastHandle,
         0,
         0,
         3,
         FastBuffer
      ) < 3
   )
   {
      Print(
         "Brak danych szybkiej średniej sygnałowej."
      );

      return;
   }

   if(
      CopyBuffer(
         SlowHandle,
         0,
         InpSlowMAShift,
         3,
         SlowBuffer
      ) < 3
   )
   {
      Print(
         "Brak danych wolnej średniej sygnałowej."
      );

      return;
   }

   if(
      CopyBuffer(
         TrendFastHandle,
         0,
         0,
         3,
         TrendFastBuffer
      ) < 3
   )
   {
      Print(
         "Brak danych szybkiej średniej trendowej."
      );

      return;
   }

   if(
      CopyBuffer(
         TrendSlowHandle,
         0,
         0,
         3,
         TrendSlowBuffer
      ) < 3
   )
   {
      Print(
         "Brak danych wolnej średniej trendowej."
      );

      return;
   }

   bool crossUp =
      FastBuffer[1] > SlowBuffer[1] &&
      FastBuffer[2] <= SlowBuffer[2];

   bool crossDown =
      FastBuffer[1] < SlowBuffer[1] &&
      FastBuffer[2] >= SlowBuffer[2];

   bool trendBuy =
      TrendFastBuffer[1] >
      TrendSlowBuffer[1];

   bool trendSell =
      TrendFastBuffer[1] <
      TrendSlowBuffer[1];

   if(crossUp && trendBuy)
   {
      if(!IsTrendMoveEntryAllowed(true))
         return;

      OpenTrade(
         ORDER_TYPE_BUY
      );
   }

   if(crossDown && trendSell)
   {
      if(!IsTrendMoveEntryAllowed(false))
         return;

      OpenTrade(
         ORDER_TYPE_SELL
      );
   }
}

bool GetHighestHigh(
   const int lookback,
   double &highest
)
{
   if(lookback < 1)
      return false;

   if(
      Bars(
         Symbol(),
         Period()
      ) < lookback + 5
   )
   {
      return false;
   }

   double highs[];

   ArraySetAsSeries(
      highs,
      true
   );

   int copied = CopyHigh(
      Symbol(),
      Period(),
      1,
      lookback,
      highs
   );

   if(copied < lookback)
      return false;

   int highestIndex = ArrayMaximum(
      highs,
      0,
      lookback
   );

   if(highestIndex < 0)
      return false;

   highest =
      highs[highestIndex];

   return true;
}

bool GetLowestLow(
   const int lookback,
   double &lowest
)
{
   if(lookback < 1)
      return false;

   if(
      Bars(
         Symbol(),
         Period()
      ) < lookback + 5
   )
   {
      return false;
   }

   double lows[];

   ArraySetAsSeries(
      lows,
      true
   );

   int copied = CopyLow(
      Symbol(),
      Period(),
      1,
      lookback,
      lows
   );

   if(copied < lookback)
      return false;

   int lowestIndex = ArrayMinimum(
      lows,
