   lowest =
      lows[lowestIndex];

   return true;
}

int GetTrendRunBars(
   bool wantBuyTrend,
   int maxLookback
)
{
   int availableBars = Bars(
      Symbol(),
      Period()
   );

   int limit = MathMin(
      maxLookback,
      availableBars - 2
   );

   if(limit < 1)
      return 0;

   double trendFastValues[];
   double trendSlowValues[];

   ArraySetAsSeries(
      trendFastValues,
      true
   );

   ArraySetAsSeries(
      trendSlowValues,
      true
   );

   if(
      CopyBuffer(
         TrendFastHandle,
         0,
         1,
         limit,
         trendFastValues
      ) < limit
   )
   {
      return 0;
   }

   if(
      CopyBuffer(
         TrendSlowHandle,
         0,
         1,
         limit,
         trendSlowValues
      ) < limit
   )
   {
      return 0;
   }

   int count = 0;

   for(
      int index = 0;
      index < limit;
      index++
   )
   {
      if(wantBuyTrend)
      {
         if(
            trendFastValues[index] >
            trendSlowValues[index]
         )
         {
            count++;
         }
         else
         {
            break;
         }
      }
      else
      {
         if(
            trendFastValues[index] <
            trendSlowValues[index]
         )
         {
            count++;
         }
         else
         {
            break;
         }
      }
   }

   return count;
}

void OpenTrade(ENUM_ORDER_TYPE type)
{
   bool wantBuy =
      type == ORDER_TYPE_BUY;

   if(!IsSingleOpenPositionAllowed())
      return;

   if(!IsDirectionCooldownAllowed(type))
      return;

   if(!IsTrendPositionLimitAllowed(wantBuy))
      return;

   double ask = SymbolInfoDouble(
      Symbol(),
      SYMBOL_ASK
   );

   double bid = SymbolInfoDouble(
      Symbol(),
      SYMBOL_BID
   );

   double point = SymbolInfoDouble(
      Symbol(),
      SYMBOL_POINT
   );

   double pipSize =
      PipSize(Symbol());

   if(
      ask <= 0.0 ||
      bid <= 0.0 ||
      point <= 0.0 ||
      pipSize <= 0.0
   )
   {
      PrintFormat(
         "SKIP %s: nie można pobrać aktualnej ceny.",
         wantBuy ? "BUY" : "SELL"
      );

      return;
   }

   double price =
      wantBuy ? ask : bid;

   double minimumStopDistance =
      (double)SymbolInfoInteger(
         Symbol(),
         SYMBOL_TRADE_STOPS_LEVEL
      )
      *
      point;

   int roomBarsUsed = GetTrendRunBars(
      wantBuy,
      InpRoomLookbackBars
   );

   if(roomBarsUsed < 1)
   {
      PrintFormat(
         "SKIP %s: brak świec aktualnego trendu dla ROOM.",
         wantBuy ? "BUY" : "SELL"
      );

      return;
   }

   double requiredRoom =
      PipsToDouble(
         InpMinRoomPips
      );

   double roomExtreme = 0.0;

   if(wantBuy)
   {
      double highest = 0.0;

      if(
         !GetHighestHigh(
            roomBarsUsed,
            highest
         )
      )
      {
         Print(
            "SKIP BUY: nie można wyliczyć wcześniejszego HIGH."
         );

         return;
      }

      roomExtreme = highest;

      double room =
         roomExtreme - ask;

      double roomPips =
         room / pipSize;

      if(room < requiredRoom)
      {
         PrintFormat(
            "SKIP BUY: za mało miejsca do HIGH. ROOM=%.1f pips, wymagane=%.1f.",
            roomPips,
            InpMinRoomPips
         );

         return;
      }
   }
   else
   {
      double lowest = 0.0;

      if(
         !GetLowestLow(
            roomBarsUsed,
            lowest
         )
      )
      {
         Print(
            "SKIP SELL: nie można wyliczyć wcześniejszego LOW."
         );

         return;
      }

      roomExtreme = lowest;

      double room =
         bid - roomExtreme;

      double roomPips =
         room / pipSize;

      if(room < requiredRoom)
      {
         PrintFormat(
            "SKIP SELL: za mało miejsca do LOW. ROOM=%.1f pips, wymagane=%.1f.",
            roomPips,
            InpMinRoomPips
         );

         return;
      }
   }

   double trendSlowValues[];

   ArraySetAsSeries(
      trendSlowValues,
      true
   );

   if(
      CopyBuffer(
         TrendSlowHandle,
         0,
         0,
         2,
         trendSlowValues
      ) < 2
   )
   {
      PrintFormat(
         "SKIP %s: nie można pobrać wolnej średniej trendowej.",
         wantBuy ? "BUY" : "SELL"
      );

      return;
   }

   double trendSlowMA =
      trendSlowValues[1];

   if(trendSlowMA <= 0.0)
   {
      Print(
         "Nieprawidłowa wartość wolnej średniej trendowej."
      );

      return;
   }

   double slBuffer =
      PipsToDouble(
         InpSLBufferPips
      );

   double sl = 0.0;

   if(wantBuy)
   {
      sl =
         trendSlowMA -
         slBuffer;

      if(sl >= bid)
      {
         PrintFormat(
            "SKIP BUY: średnia %d nie znajduje się pod ceną. Cena=%.5f, średnia=%.5f, SL=%.5f.",
            InpTrendSlowMABars,
            price,
            trendSlowMA,
            sl
         );

         return;
      }

      double maximumAllowedSL =
         bid -
         minimumStopDistance;

      if(
         minimumStopDistance > 0.0 &&
         sl > maximumAllowedSL
      )
      {
         sl =
            maximumAllowedSL;
      }
   }
   else
   {
      sl =
         trendSlowMA +
         slBuffer;

      if(sl <= ask)
      {
         PrintFormat(
            "SKIP SELL: średnia %d nie znajduje się nad ceną. Cena=%.5f, średnia=%.5f, SL=%.5f.",
            InpTrendSlowMABars,
            price,
            trendSlowMA,
            sl
         );

         return;
      }

      double minimumAllowedSL =
         ask +
         minimumStopDistance;

      if(
         minimumStopDistance > 0.0 &&
         sl < minimumAllowedSL
      )
      {
         sl =
            minimumAllowedSL;
      }
   }

   double slDistancePips = 0.0;

   if(wantBuy)
   {
      slDistancePips =
         (
            price -
            sl
         )
         /
         pipSize;
   }
   else
   {
      slDistancePips =
         (
            sl -
            price
         )
         /
         pipSize;
   }

   if(slDistancePips <= 0.0)
   {
      PrintFormat(
         "SKIP %s: SL znajduje się po złej stronie ceny.",
         wantBuy ? "BUY" : "SELL"
      );

      return;
   }

   if(
      InpMaxSLPips > 0.0 &&
      slDistancePips > InpMaxSLPips
   )
   {
      PrintFormat(
         "SKIP %s: SL za daleko. Odległość=%.1f pips, limit=%.1f.",
         wantBuy ? "BUY" : "SELL",
         slDistancePips,
         InpMaxSLPips
      );

      return;
   }

   double tp = 0.0;

   if(InpTPMode == TP_MODE_OFF)
   {
      tp = 0.0;
   }
   else if(InpTPMode == TP_MODE_FIXED)
   {
      if(InpTakeProfitPips > 0.0)
      {
         if(wantBuy)
         {
            tp =
               price +
               TakeProfit;
         }
         else
         {
            tp =
               price -
               TakeProfit;
         }
      }
   }
   else if(InpTPMode == TP_MODE_DYNAMIC_EXTREME)
   {
      double tpBuffer =
         PipsToDouble(
            InpTPBufferPips
         );

      if(wantBuy)
      {
         tp =
            roomExtreme -
            tpBuffer;

         if(
            tp <=
            price +
            minimumStopDistance
         )
         {
            Print(
               "SKIP BUY: dynamiczny TP jest za blisko."
            );

            return;
         }
      }
      else
      {
         tp =
            roomExtreme +
            tpBuffer;

         if(
            tp >=
            price -
            minimumStopDistance
         )
         {
            Print(
               "SKIP SELL: dynamiczny TP jest za blisko."
            );

            return;
         }
      }
   }

   if(
      tp > 0.0 &&
      minimumStopDistance > 0.0
   )
   {
      if(wantBuy)
      {
         double minimumTP =
            ask +
            minimumStopDistance;

         if(tp < minimumTP)
            tp = minimumTP;
      }
      else
      {
         double maximumTP =
            bid -
            minimumStopDistance;

         if(tp > maximumTP)
            tp = maximumTP;
      }
   }

   if(
      InpRequireTPGreaterThanSL &&
      tp > 0.0
   )
   {
      double tpDistancePips = 0.0;

      if(wantBuy)
      {
         tpDistancePips =
            (
               tp -
               price
            )
            /
            pipSize;
      }
      else
      {
         tpDistancePips =
            (
               price -
               tp
            )
            /
            pipSize;
      }

      if(tpDistancePips <= slDistancePips)
      {
         PrintFormat(
            "SKIP %s: TP nie jest większy od SL. TP=%.1f pips, SL=%.1f pips.",
            wantBuy ? "BUY" : "SELL",
            tpDistancePips,
            slDistancePips
         );

         return;
      }
   }

   price = NormalizeDouble(
      price,
      Digits()
   );

   sl = NormalizeDouble(
      sl,
      Digits()
   );

   if(tp != 0.0)
   {
      tp = NormalizeDouble(
         tp,
         Digits()
      );
   }

   PrintFormat(
      "OPEN %s: cena=%.5f, SL=%.5f na MA %d, średnia=%.5f, SL dystans=%.1f pips, TP=%.5f.",
      wantBuy ? "BUY" : "SELL",
      price,
      sl,
      InpTrendSlowMABars,
      trendSlowMA,
      slDistancePips,
      tp
   );

   ResetLastError();

   if(
      !Trade.PositionOpen(
         Symbol(),
         type,
         InpOrderSize,
         price,
         sl,
         tp,
         InpTradeComment
      )
   )
   {
      PrintFormat(
         "Błąd otwarcia %s. Cena=%f, SL=%f, TP=%f, błąd=%d, retcode=%u, opis=%s.",
         wantBuy ? "BUY" : "SELL",
         price,
         sl,
         tp,
         GetLastError(),
         Trade.ResultRetcode(),
         Trade.ResultRetcodeDescription()
      );
   }
   else
   {
      PrintFormat(
         "OTWARTO %s. SL ustawiony na średniej %d z buforem %.1f pips.",
         wantBuy ? "BUY" : "SELL",
         InpTrendSlowMABars,
         InpSLBufferPips
      );
   }
}

void ApplyTrailingStop()
{
   double ask = SymbolInfoDouble(
      Symbol(),
      SYMBOL_ASK
   );

   double bid = SymbolInfoDouble(
      Symbol(),
      SYMBOL_BID
   );

   double point = SymbolInfoDouble(
      Symbol(),
      SYMBOL_POINT
   );

   if(
      ask <= 0.0 ||
      bid <= 0.0 ||
      point <= 0.0
   )
   {
      return;
   }

   double trendSlowValues[];

   ArraySetAsSeries(
      trendSlowValues,
      true
   );

   if(
      CopyBuffer(
         TrendSlowHandle,
         0,
         0,
         1,
         trendSlowValues
      ) < 1
   )
   {
      Print(
         "Trailing MA: nie można pobrać wartości wolnej średniej."
      );

      return;
   }

   double trendSlowMA =
      trendSlowValues[0];

   if(trendSlowMA <= 0.0)
      return;

   double slBuffer =
      PipsToDouble(
         InpSLBufferPips
      );

   long stopsLevel =
      SymbolInfoInteger(
         Symbol(),
         SYMBOL_TRADE_STOPS_LEVEL
      );

   long freezeLevel =
      SymbolInfoInteger(
         Symbol(),
         SYMBOL_TRADE_FREEZE_LEVEL
      );

   double minimumStopDistance =
      (double)MathMax(
         stopsLevel,
         freezeLevel
      )
      *
      point;

   for(
      int index = PositionsTotal() - 1;
      index >= 0;
      index--
   )
   {
      ulong ticket =
         PositionGetTicket(index);

      if(ticket == 0)
         continue;

      if(!Position.SelectByTicket(ticket))
         continue;

      if(Position.Symbol() != Symbol())
         continue;

      if(Position.Magic() != InpMagic)
         continue;

      double currentSL =
         Position.StopLoss();

      double newSL = 0.0;

      if(
         Position.PositionType() ==
         POSITION_TYPE_BUY
      )
      {
         newSL =
            trendSlowMA -
            slBuffer;

         double maximumAllowedSL =
            bid -
            minimumStopDistance;

         if(newSL > maximumAllowedSL)
         {
            newSL =
               maximumAllowedSL;
         }

         newSL =
            NormalizeDouble(
               newSL,
               Digits()
            );

         if(
            newSL <= 0.0 ||
            newSL >= bid
         )
         {
            continue;
         }

         if(
            currentSL > 0.0 &&
            newSL <= currentSL + point * 0.5
         )
         {
            continue;
         }

         ResetLastError();

         if(
            !Trade.PositionModify(
               ticket,
               newSL,
               Position.TakeProfit()
            )
         )
         {
            PrintFormat(
               "Błąd trailing MA BUY. Ticket=%I64u, MA=%.5f, nowy SL=%.5f, retcode=%u, opis=%s.",
               ticket,
               trendSlowMA,
               newSL,
               Trade.ResultRetcode(),
               Trade.ResultRetcodeDescription()
            );
         }
         else
         {
            PrintFormat(
               "Trailing MA BUY: EMA %d=%.5f, bufor=%.1f pips, SL=%.5f.",
               InpTrendSlowMABars,
               trendSlowMA,
               InpSLBufferPips,
               newSL
            );
         }
      }

      if(
         Position.PositionType() ==
         POSITION_TYPE_SELL
      )
      {
         newSL =
            trendSlowMA +
            slBuffer;

         double minimumAllowedSL =
            ask +
            minimumStopDistance;

         if(newSL < minimumAllowedSL)
         {
            newSL =
               minimumAllowedSL;
         }

         newSL =
            NormalizeDouble(
               newSL,
               Digits()
            );

         if(newSL <= ask)
         {
            continue;
         }

         if(
            currentSL > 0.0 &&
            newSL >= currentSL - point * 0.5
         )
         {
            continue;
         }

         ResetLastError();

         if(
            !Trade.PositionModify(
               ticket,
               newSL,
               Position.TakeProfit()
            )
         )
         {
            PrintFormat(
               "Błąd trailing MA SELL. Ticket=%I64u, MA=%.5f, nowy SL=%.5f, retcode=%u, opis=%s.",
               ticket,
               trendSlowMA,
               newSL,
               Trade.ResultRetcode(),
               Trade.ResultRetcodeDescription()
            );
         }
         else
         {
            PrintFormat(
               "Trailing MA SELL: EMA %d=%.5f, bufor=%.1f pips, SL=%.5f.",
               InpTrendSlowMABars,
               trendSlowMA,
               InpSLBufferPips,
               newSL
            );
         }
      }
   }
}
