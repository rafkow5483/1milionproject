bool IsMarketOpen(
   string symbol,
   datetime time
)
{
   static string lastSymbol = "";

   static bool isOpen = false;

   static datetime sessionStart = 0;
   static datetime sessionEnd   = 0;

   if(
      lastSymbol == symbol &&
      sessionEnd > sessionStart
   )
   {
      if(
         (
            isOpen &&
            time >= sessionStart &&
            time <= sessionEnd
         )
         ||
         (
            !isOpen &&
            time > sessionStart &&
            time < sessionEnd
         )
      )
      {
         return isOpen;
      }
   }

   lastSymbol = symbol;

   MqlDateTime marketTime;

   TimeToStruct(
      time,
      marketTime
   );

   datetime secondsFromMidnight =
      marketTime.hour * 3600 +
      marketTime.min * 60 +
      marketTime.sec;

   marketTime.hour = 0;
   marketTime.min  = 0;
   marketTime.sec  = 0;

   datetime dayStart =
      StructToTime(marketTime);

   datetime dayEnd =
      dayStart + 86400;

   datetime fromTime;
   datetime toTime;

   sessionStart = dayStart;
   sessionEnd   = dayEnd;

   for(int session = 0; ; session++)
   {
      if(
         !SymbolInfoSessionTrade(
            symbol,
            (ENUM_DAY_OF_WEEK)marketTime.day_of_week,
            session,
            fromTime,
            toTime
         )
      )
      {
         sessionEnd = dayEnd;
         isOpen     = false;

         return false;
      }

      if(secondsFromMidnight < fromTime)
      {
         sessionEnd =
            dayStart + fromTime;

         isOpen = false;

         return false;
      }

      if(secondsFromMidnight > toTime)
      {
         sessionStart =
            dayStart + toTime;

         continue;
      }

      sessionStart =
         dayStart + fromTime;

      sessionEnd =
         dayStart + toTime;

      isOpen = true;

      return true;
   }

   return false;
}

bool IsNewBar(bool firstCall)
{
   static datetime previousBarTime = 0;

   datetime currentBarTime = iTime(
      Symbol(),
      Period(),
      0
   );

   if(!firstCall)
      return false;

   if(currentBarTime <= 0)
      return false;

   if(previousBarTime != currentBarTime)
   {
      previousBarTime = currentBarTime;
      return true;
   }

   return false;
}

