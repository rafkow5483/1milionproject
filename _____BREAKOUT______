//+------------------------------------------------------------------+
//|                EMA 8/21 Multi Retrace EA                         |
//|                                                                  |
//| SELL: EMA8 crosses below EMA21                                   |
//|       new LOW -> retrace X pips -> SELL                          |
//|                                                                  |
//| BUY:  EMA8 crosses above EMA21                                   |
//|       new HIGH -> retrace X pips -> BUY                          |
//+------------------------------------------------------------------+
#property strict

#include <Trade/Trade.mqh>

CTrade trade;

//====================================================================
// INPUTS
//====================================================================

input double Lots             = 0.01;

input int    FastEMAPeriod    = 8;
input int    SlowEMAPeriod    = 21;

input double RetracePips      = 100.0;
input double StopLossPips     = 100.0;
input double TakeProfitPips   = 100.0;

input ulong  MagicNumber      = 111;

// 0.0 = automatyczne wyliczenie wielkości pipsa
// Przykład:
// EURUSD 5 cyfr -> 0.0001
// XAUUSD 2/3 cyfry -> zwykle 0.01
//
// Jeżeli Twój broker inaczej liczy XAUUSD,
// możesz wpisać tutaj np. 0.01 / 0.1 / 1.0
input double CustomPipSize    = 0.0;

//====================================================================
// GLOBAL VARIABLES
//====================================================================

int fastEMAHandle = INVALID_HANDLE;
int slowEMAHandle = INVALID_HANDLE;

enum TradeMode
{
   MODE_NONE = 0,
   MODE_SELL = 1,
   MODE_BUY  = 2
};

TradeMode currentMode = MODE_NONE;

// SELL
double sellLow = 0.0;
bool sellEntryAvailable = false;

// BUY
double buyHigh = 0.0;
bool buyEntryAvailable = false;

datetime lastBarTime = 0;

//====================================================================
// PIP SIZE
//====================================================================

double GetPipSize()
{
   if(CustomPipSize > 0.0)
      return CustomPipSize;

   int digits = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
   double point = SymbolInfoDouble(_Symbol, SYMBOL_POINT);

   // Standard FX:
   // EURUSD 1.12345 -> pip = 0.0001
   // USDJPY 123.456 -> pip = 0.01
   if(digits == 3 || digits == 5)
      return point * 10.0;

   return point;
}

//====================================================================
// NORMALIZE PRICE
//====================================================================

double NormalizePrice(double price)
{
   int digits = (int)SymbolInfoInteger(_Symbol, SYMBOL_DIGITS);
   return NormalizeDouble(price, digits);
}

//====================================================================
// NEW BAR
//====================================================================

bool IsNewBar()
{
   datetime currentBarTime = iTime(_Symbol, _Period, 0);

   if(currentBarTime != lastBarTime)
   {
      lastBarTime = currentBarTime;
      return true;
   }

   return false;
}

//====================================================================
// CHECK EMA CROSS
//====================================================================

void CheckEMACross()
{
   double fastBuffer[3];
   double slowBuffer[3];

   if(CopyBuffer(fastEMAHandle, 0, 0, 3, fastBuffer) < 3)
      return;

   if(CopyBuffer(slowEMAHandle, 0, 0, 3, slowBuffer) < 3)
      return;

   // Przy CopyBuffer do zwykłej tablicy:
   // [0] = świeca 2
   // [1] = świeca 1 - ostatnia zamknięta
   // [2] = świeca 0 - aktualna

   double fast2 = fastBuffer[0];
   double fast1 = fastBuffer[1];

   double slow2 = slowBuffer[0];
   double slow1 = slowBuffer[1];

   //==============================================================
   // EMA8 PRZECINA EMA21 W DÓŁ -> SELL
   //==============================================================

   if(fast2 >= slow2 && fast1 < slow1)
   {
      currentMode = MODE_SELL;

      sellLow = iLow(_Symbol, _Period, 1);

      sellEntryAvailable = true;

      buyEntryAvailable = false;
      buyHigh = 0.0;

      Print("--------------------------------------------------");
      Print("EMA8 przecięła EMA21 W DÓŁ");
      Print("TRYB SELL AKTYWNY");
      Print("Startowe LOW = ", sellLow);
      Print("--------------------------------------------------");

      return;
   }

   //==============================================================
   // EMA8 PRZECINA EMA21 W GÓRĘ -> BUY
   //==============================================================

   if(fast2 <= slow2 && fast1 > slow1)
   {
      currentMode = MODE_BUY;

      buyHigh = iHigh(_Symbol, _Period, 1);

      buyEntryAvailable = true;

      sellEntryAvailable = false;
      sellLow = 0.0;

      Print("--------------------------------------------------");
      Print("EMA8 przecięła EMA21 W GÓRĘ");
      Print("TRYB BUY AKTYWNY");
      Print("Startowe HIGH = ", buyHigh);
      Print("--------------------------------------------------");

      return;
   }
}

//====================================================================
// OPEN SELL
//====================================================================

bool OpenSell()
{
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);

   if(bid <= 0)
      return false;

   double pip = GetPipSize();

   double sl = bid + StopLossPips * pip;
   double tp = bid - TakeProfitPips * pip;

   sl = NormalizePrice(sl);
   tp = NormalizePrice(tp);

   trade.SetExpertMagicNumber(MagicNumber);

   bool result = trade.Sell(
      Lots,
      _Symbol,
      0.0,
      sl,
      tp,
      "EMA8/21 Retrace SELL"
   );

   if(result)
   {
      Print("==================================================");
      Print("SELL OTWARTY");
      Print("Cena: ", bid);
      Print("Low odniesienia: ", sellLow);
      Print("SL: ", sl);
      Print("TP: ", tp);
      Print("==================================================");

      return true;
   }

   Print("BŁĄD SELL: ",
         trade.ResultRetcode(),
         " ",
         trade.ResultRetcodeDescription());

   return false;
}

//====================================================================
// OPEN BUY
//====================================================================

bool OpenBuy()
{
   double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);

   if(ask <= 0)
      return false;

   double pip = GetPipSize();

   double sl = ask - StopLossPips * pip;
   double tp = ask + TakeProfitPips * pip;

   sl = NormalizePrice(sl);
   tp = NormalizePrice(tp);

   trade.SetExpertMagicNumber(MagicNumber);

   bool result = trade.Buy(
      Lots,
      _Symbol,
      0.0,
      sl,
      tp,
      "EMA8/21 Retrace BUY"
   );

   if(result)
   {
      Print("==================================================");
      Print("BUY OTWARTY");
      Print("Cena: ", ask);
      Print("High odniesienia: ", buyHigh);
      Print("SL: ", sl);
      Print("TP: ", tp);
      Print("==================================================");

      return true;
   }

   Print("BŁĄD BUY: ",
         trade.ResultRetcode(),
         " ",
         trade.ResultRetcodeDescription());

   return false;
}

//====================================================================
// SELL LOGIC
//====================================================================

void ProcessSell()
{
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);

   if(bid <= 0)
      return;

   double pip = GetPipSize();

   //==============================================================
   // NOWE LOW
   //==============================================================

   if(sellLow == 0.0 || bid < sellLow)
   {
      sellLow = bid;

      // Każde nowe low daje NOWĄ możliwość pozycji
      sellEntryAvailable = true;

      Print("Nowe SELL LOW: ", sellLow);
   }

   //==============================================================
   // RETRACE
   //==============================================================

   if(!sellEntryAvailable)
      return;

   double retraceLevel = sellLow + RetracePips * pip;

   if(bid >= retraceLevel)
   {
      Print("SELL retrace osiągnięty.");
      Print("Low = ", sellLow);
      Print("Poziom wejścia = ", retraceLevel);
      Print("Aktualna cena = ", bid);

      if(OpenSell())
      {
         // Z tego konkretnego LOW już weszliśmy.
         // Następna pozycja wymaga NOWEGO LOW.
         sellEntryAvailable = false;
      }
   }
}

//====================================================================
// BUY LOGIC
//====================================================================

void ProcessBuy()
{
   double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);

   if(bid <= 0)
      return;

   double pip = GetPipSize();

   //==============================================================
   // NOWE HIGH
   //==============================================================

   if(buyHigh == 0.0 || bid > buyHigh)
   {
      buyHigh = bid;

      // Każde nowe high daje NOWĄ możliwość pozycji
      buyEntryAvailable = true;

      Print("Nowe BUY HIGH: ", buyHigh);
   }

   //==============================================================
   // RETRACE
   //==============================================================

   if(!buyEntryAvailable)
      return;

   double retraceLevel = buyHigh - RetracePips * pip;

   if(bid <= retraceLevel)
   {
      Print("BUY retrace osiągnięty.");
      Print("High = ", buyHigh);
      Print("Poziom wejścia = ", retraceLevel);
      Print("Aktualna cena = ", bid);

      if(OpenBuy())
      {
         // Z tego konkretnego HIGH już weszliśmy.
         // Następna pozycja wymaga NOWEGO HIGH.
         buyEntryAvailable = false;
      }
   }
}

//====================================================================
// INIT
//====================================================================

int OnInit()
{
   trade.SetExpertMagicNumber(MagicNumber);

   fastEMAHandle = iMA(
      _Symbol,
      _Period,
      FastEMAPeriod,
      0,
      MODE_EMA,
      PRICE_CLOSE
   );

   slowEMAHandle = iMA(
      _Symbol,
      _Period,
      SlowEMAPeriod,
      0,
      MODE_EMA,
      PRICE_CLOSE
   );

   if(fastEMAHandle == INVALID_HANDLE ||
      slowEMAHandle == INVALID_HANDLE)
   {
      Print("Błąd tworzenia EMA.");
      return INIT_FAILED;
   }

   lastBarTime = iTime(_Symbol, _Period, 0);

   Print("EA uruchomiony.");
   Print("EMA ", FastEMAPeriod, " / EMA ", SlowEMAPeriod);
   Print("Retrace: ", RetracePips, " pips");
   Print("SL: ", StopLossPips, " pips");
   Print("TP: ", TakeProfitPips, " pips");
   Print("Pip size: ", GetPipSize());

   return INIT_SUCCEEDED;
}

//====================================================================
// DEINIT
//====================================================================

void OnDeinit(const int reason)
{
   if(fastEMAHandle != INVALID_HANDLE)
      IndicatorRelease(fastEMAHandle);

   if(slowEMAHandle != INVALID_HANDLE)
      IndicatorRelease(slowEMAHandle);
}

//====================================================================
// TICK
//====================================================================

void OnTick()
{
   // Sprawdzamy przecięcia EMA raz po zamknięciu świecy
   if(IsNewBar())
      CheckEMACross();

   //==============================================================
   // SELL
   //==============================================================

   if(currentMode == MODE_SELL)
   {
      ProcessSell();
      return;
   }

   //==============================================================
   // BUY
   //==============================================================

   if(currentMode == MODE_BUY)
   {
      ProcessBuy();
      return;
   }
}
