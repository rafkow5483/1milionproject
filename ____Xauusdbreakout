input bool               InpUseTakeProfit      = true; // false = zysk zamykany warunkiem Exit MA +/- offset
input double             InpMaxSLPipsAtEntry    = 300.0;  // Wejscie dopiero gdy odleglosc ceny od SL <= tej wartosci
input double             InpInitialSLOffsetPips = 300.0;  // Poczatkowy SL od Slow MA (domyslnie EMA 21)
input double             InpProfitExitOffsetPips = 100.0; // Offset wyjscia z zysku od Exit MA (domyslnie EMA 50)
input double             InpBreakEvenTriggerPips = 500.0; // Po ilu pipsach zysku ustawic SL na cene wejscia
