double        FilterFastBuffer[];
int           FilterSlowHandle;
double        FilterSlowBuffer[];

// Sygnał z przecięcia:
//  0 = brak
//  1 = oczekuj BUY
// -1 = oczekuj SELL
int           PendingSignal = 0;

// Identyfikator swiecy, na ktorej powstal aktualny sygnal
// oraz licznik wejsc wykorzystanych z tego przeciecia.
datetime      PendingCrossBarTime = 0;
int           TradesOpenedForCurrentCross = 0;

