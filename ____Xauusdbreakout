//
//	Initialisation
//
int OnInit() {

   TakeProfit   = PipsToDouble( InpTakeProfitPips );
   BreakEvenTrigger = PipsToDouble( InpBreakEvenTriggerPips );

   Trade.SetExpertMagicNumber( InpMagic );

   FastHandle = iMA( Symbol(), Period(), InpFastMABars, 0, InpFastMAMethod, InpFastMAAppliedPrice );
   ArraySetAsSeries( FastBuffer, true );

   //	I could use the shift here but I won't
   SlowHandle = iMA( Symbol(), Period(), InpSlowMABars, 0, InpSlowMAMethod, InpSlowMAAppliedPrice );
   ArraySetAsSeries( SlowBuffer, true );

   // Trzecia srednia - uzywana tylko do zamykania pozycji z zyskiem.
   ExitHandle = iMA( Symbol(), Period(), InpExitMABars, 0, InpExitMAMethod, InpExitMAAppliedPrice );
   ArraySetAsSeries( ExitBuffer, true );

   // Dwie dodatkowe srednie uzywane tylko jako filtr kierunku wejscia.
   FilterFastHandle = iMA( Symbol(), Period(), InpFilterFastMABars, 0, InpFilterMAMethod, InpFilterMAAppliedPrice );
   ArraySetAsSeries( FilterFastBuffer, true );

   FilterSlowHandle = iMA( Symbol(), Period(), InpFilterSlowMABars, 0, InpFilterMAMethod, InpFilterMAAppliedPrice );
   ArraySetAsSeries( FilterSlowBuffer, true );

   if ( FastHandle == INVALID_HANDLE || SlowHandle == INVALID_HANDLE || ExitHandle == INVALID_HANDLE ||
        FilterFastHandle == INVALID_HANDLE || FilterSlowHandle == INVALID_HANDLE ) {
      Print( "Error creating handles to moving averages" );
      return INIT_FAILED;
   }

   // In case of starting the expert mid bar block the new bar result
   //	https://youtu.be/XHJPpvI2h50
   IsNewBar( true );

   return ( INIT_SUCCEEDED );
}

void OnDeinit( const int reason ) {
   IndicatorRelease( FastHandle );
   IndicatorRelease( SlowHandle );
   IndicatorRelease( ExitHandle );
   IndicatorRelease( FilterFastHandle );
   IndicatorRelease( FilterSlowHandle );
}

void OnTick() {

   // Quick check if trading is possible
   if ( !IsTradeAllowed() ) return;
   if ( !IsMarketOpen() ) return;

   // Wyjscie z pozycji sprawdzamy na KAZDYM ticku.
   // Do zamykania zysku uzywamy TRZECIEJ sredniej Exit MA (domyslnie EMA 50).
   // BUY: pozycja na plusie i BID <= Exit MA - offset.
   // SELL: pozycja na plusie i ASK >= Exit MA + offset.
   ApplyExitMAProfitExit();

   // Opcjonalny break-even. Po osiagnieciu ustawionego zysku
   // SL jest przesuwany RAZ na cene wejscia i pozniej juz nie podaza za cena.
   if ( InpUseBreakEven && BreakEvenTrigger > 0 )
      ApplyBreakEven();

   // Poza godzinami handlu nie otwieramy nowych pozycji.
   // Kasujemy tez stary oczekujacy sygnal, zeby nie wszedl kolejnego dnia.
   if ( !IsTimeToTrade() ) {
      PendingSignal = 0;
      PendingCrossBarTime = 0;
      TradesOpenedForCurrentCross = 0;
      return;
   }

   bool newBar = IsNewBar( true );

   // Na nowej swiecy najpierw aktualizujemy stan sygnalu z przeciecia.
   // Dzieki temu stary BUY nie otworzy sie na pierwszym ticku swiecy,
   // na ktorej zostalo juz potwierdzone przeciwne przeciecie SELL.
   if ( newBar ) {

      if ( CopyBuffer( FastHandle, 0, 0, 3, FastBuffer ) < 3 ) {
         Print( "Insufficient results from fast MA" );
         return;
      }

      if ( CopyBuffer( SlowHandle, 0, InpSlowMAShift, 3, SlowBuffer ) < 3 ) {
         Print( "Insufficient results from slow MA" );
         return;
      }

      // Pobierz dodatkowe EMA filtra. Na przecieciu sprawdzamy zamknieta swiece [1].
      if ( CopyBuffer( FilterFastHandle, 0, 0, 3, FilterFastBuffer ) < 3 ||
           CopyBuffer( FilterSlowHandle, 0, 0, 3, FilterSlowBuffer ) < 3 ) {
         Print( "Insufficient results from trend filter MA" );
         return;
      }

      bool buyFilterOK  = ( !InpUseTrendFilter || FilterFastBuffer[1] > FilterSlowBuffer[1] );
      bool sellFilterOK = ( !InpUseTrendFilter || FilterFastBuffer[1] < FilterSlowBuffer[1] );

      // Fast przecina Slow od dolu -> BUY tylko gdy filtr EMA 40 > EMA 104.
      if ( ( FastBuffer[1] > SlowBuffer[1] ) && !( FastBuffer[2] > SlowBuffer[2] ) && buyFilterOK ) {
         PendingSignal = 1;
         PendingCrossBarTime = iTime( Symbol(), Period(), 1 );
         TradesOpenedForCurrentCross = 0;
         Print( "SIGNAL BUY: przeciecie wykryte. Maks. wejsc z tego przeciecia = ", InpMaxTradesPerCross,
                ". SL = Slow MA - ", DoubleToString( InpInitialSLOffsetPips, 1 ), " pips. Czekam az odleglosc SL bedzie <= ",
                DoubleToString( InpMaxSLPipsAtEntry, 1 ), " pips." );
      }
      // Fast przecina Slow od gory -> SELL tylko gdy filtr EMA 40 < EMA 104.
      else if ( ( FastBuffer[1] < SlowBuffer[1] ) && !( FastBuffer[2] < SlowBuffer[2] ) && sellFilterOK ) {
         PendingSignal = -1;
         PendingCrossBarTime = iTime( Symbol(), Period(), 1 );
         TradesOpenedForCurrentCross = 0;
         Print( "SIGNAL SELL: przeciecie wykryte. Maks. wejsc z tego przeciecia = ", InpMaxTradesPerCross,
                ". SL = Slow MA + ", DoubleToString( InpInitialSLOffsetPips, 1 ), " pips. Czekam az odleglosc SL bedzie <= ",
                DoubleToString( InpMaxSLPipsAtEntry, 1 ), " pips." );
      }
      // Przeciecie BUY bylo, ale filtr trendu je blokuje. Nie uzbrajamy sygnalu.
      else if ( ( FastBuffer[1] > SlowBuffer[1] ) && !( FastBuffer[2] > SlowBuffer[2] ) && !buyFilterOK ) {
         PendingSignal = 0;
         PendingCrossBarTime = 0;
         TradesOpenedForCurrentCross = 0;
         PrintFormat( "BLOCK BUY: EMA %d = %f nie jest nad EMA %d = %f",
                      InpFilterFastMABars, FilterFastBuffer[1], InpFilterSlowMABars, FilterSlowBuffer[1] );
      }
      // Przeciecie SELL bylo, ale filtr trendu je blokuje. Nie uzbrajamy sygnalu.
      else if ( ( FastBuffer[1] < SlowBuffer[1] ) && !( FastBuffer[2] < SlowBuffer[2] ) && !sellFilterOK ) {
         PendingSignal = 0;
         PendingCrossBarTime = 0;
         TradesOpenedForCurrentCross = 0;
         PrintFormat( "BLOCK SELL: EMA %d = %f nie jest pod EMA %d = %f",
                      InpFilterFastMABars, FilterFastBuffer[1], InpFilterSlowMABars, FilterSlowBuffer[1] );
      }
      else {
         // Jesli oczekiwalismy BUY, ale Fast nie jest juz nad Slow, anuluj.
         if ( PendingSignal == 1 && FastBuffer[1] <= SlowBuffer[1] ) {
            Print( "CANCEL BUY: Fast MA nie jest juz nad Slow MA." );
            PendingSignal = 0;
            PendingCrossBarTime = 0;
            TradesOpenedForCurrentCross = 0;
         }

         // Jesli oczekiwalismy SELL, ale Fast nie jest juz pod Slow, anuluj.
         if ( PendingSignal == -1 && FastBuffer[1] >= SlowBuffer[1] ) {
            Print( "CANCEL SELL: Fast MA nie jest juz pod Slow MA." );
            PendingSignal = 0;
            PendingCrossBarTime = 0;
            TradesOpenedForCurrentCross = 0;
         }
      }
   }

   // Po przecieciu sprawdzamy wejscie na KAZDYM ticku.
   // Jesli SL wyliczony 10 pips za Slow MA jest nadal dalej niz 50 pips -> czekamy.
   // Gdy odleglosc spadnie do <= 50 pips -> otwieramy.
   TryOpenPendingSignal();
}

bool HasOpenPosition() {

   for ( int i = PositionsTotal() - 1; i >= 0; i-- ) {
      ulong ticket = PositionGetTicket( i );
      if ( !PositionSelectByTicket( ticket ) ) continue;

      if ( PositionGetString( POSITION_SYMBOL ) != Symbol() ) continue;
      if ( (int)PositionGetInteger( POSITION_MAGIC ) != InpMagic ) continue;

      return true;
   }

   return false;
}


// Oblicza poczatkowy SL wzgledem BIEZACEJ Slow MA i jego odleglosc od ceny.
// BUY  -> SL = Slow MA - InpInitialSLOffsetPips
// SELL -> SL = Slow MA + InpInitialSLOffsetPips
// Offset poczatkowego SL jest ustawiany osobno przez InpInitialSLOffsetPips.
bool GetCurrentSLData( ENUM_ORDER_TYPE type, double &price, double &sl, double &distancePips ) {

   double pip = PipSize();
   if ( pip <= 0 ) return false;

   double slowNow[1];
   if ( CopyBuffer( SlowHandle, 0, InpSlowMAShift, 1, slowNow ) < 1 ) {
      Print( "Nie udalo sie pobrac biezacej Slow MA dla SL." );
      return false;
   }

   double slowMA = slowNow[0];
   double offset = PipsToDouble( InpInitialSLOffsetPips );

   if ( type == ORDER_TYPE_BUY ) {
      price = SymbolInfoDouble( Symbol(), SYMBOL_ASK );
      sl    = slowMA - offset;

      // Dla BUY SL musi znajdowac sie ponizej aktualnej ceny.
      if ( sl <= 0 || sl >= price )
         return false;

      distancePips = ( price - sl ) / pip;
   }
   else if ( type == ORDER_TYPE_SELL ) {
      price = SymbolInfoDouble( Symbol(), SYMBOL_BID );
      sl    = slowMA + offset;

      // Dla SELL SL musi znajdowac sie powyzej aktualnej ceny.
      if ( sl <= price )
         return false;

      distancePips = ( sl - price ) / pip;
   }
   else {
      return false;
   }

   return true;
}


// Sprawdza filtr trendu bezposrednio przed otwarciem pozycji.
// BUY  -> EMA filtra szybka musi byc nad EMA filtra wolna.
// SELL -> EMA filtra szybka musi byc pod EMA filtra wolna.
bool IsTrendFilterOK( ENUM_ORDER_TYPE type ) {

   if ( !InpUseTrendFilter )
      return true;

   double filterFastNow[1];
   double filterSlowNow[1];

   if ( CopyBuffer( FilterFastHandle, 0, 0, 1, filterFastNow ) < 1 ||
        CopyBuffer( FilterSlowHandle, 0, 0, 1, filterSlowNow ) < 1 ) {
      Print( "Nie udalo sie pobrac EMA filtra trendu." );
      return false;
   }

   if ( type == ORDER_TYPE_BUY )
      return ( filterFastNow[0] > filterSlowNow[0] );

   if ( type == ORDER_TYPE_SELL )
      return ( filterFastNow[0] < filterSlowNow[0] );

   return false;
}


// Po przecieciu NIE otwiera od razu.
// Czeka, az odleglosc ceny od SL = Slow MA +/- InpInitialSLOffsetPips spadnie do limitu InpMaxSLPipsAtEntry.
void TryOpenPendingSignal() {

   if ( PendingSignal == 0 ) return;

   int maxTrades = InpMaxTradesPerCross;
   if ( maxTrades < 1 ) maxTrades = 1;

   // To przeciecie wykorzystalo juz caly ustawiony limit wejsc.
   if ( TradesOpenedForCurrentCross >= maxTrades ) {
      PendingSignal = 0;
      PendingCrossBarTime = 0;
      return;
   }

   ENUM_ORDER_TYPE type = ( PendingSignal == 1 ? ORDER_TYPE_BUY : ORDER_TYPE_SELL );

   // Filtr musi nadal byc poprawny w chwili faktycznego wejscia.
   if ( !IsTrendFilterOK( type ) )
      return;

   double price;
   double sl;
   double distancePips;
   if ( !GetCurrentSLData( type, price, sl, distancePips ) )
      return;

   if ( distancePips > InpMaxSLPipsAtEntry ) {
      return;
   }

   PrintFormat( "ENTRY READY %s: cena=%f, SL=%f, odleglosc=%.1f pips <= %.1f pips. Wejscie %d/%d",
                EnumToString( type ), price, sl, distancePips, InpMaxSLPipsAtEntry,
                TradesOpenedForCurrentCross + 1, maxTrades );

   // Gdy warunek wejscia jest spelniony, otworz wszystkie pozostale wejscia
   // do limitu ustawionego w InpMaxTradesPerCross.
   while ( TradesOpenedForCurrentCross < maxTrades ) {
      if ( !OpenTrade( type ) )
         break;

      TradesOpenedForCurrentCross++;
   }

   if ( TradesOpenedForCurrentCross >= maxTrades ) {
      PendingSignal = 0;
      PendingCrossBarTime = 0;
   }
}


// Otwiera jedna pozycje dopiero po spelnieniu warunku maksymalnej odleglosci SL.
bool OpenTrade( ENUM_ORDER_TYPE type ) {

   double price;
   double sl;
   double distancePips;
   double tp = 0.0;
   if ( !GetCurrentSLData( type, price, sl, distancePips ) )
      return false;

   // Ochrona: nawet gdyby funkcja zostala wywolana z innego miejsca,
   // nie pozwoli wejsc z SL dalszym niz ustawiony limit.
   if ( distancePips > InpMaxSLPipsAtEntry ) {
      PrintFormat( "WAIT %s: SL jest %.1f pips od ceny, limit %.1f pips.",
                   EnumToString( type ), distancePips, InpMaxSLPipsAtEntry );
      return false;
   }

   if ( InpUseTakeProfit && TakeProfit > 0 ) {
      if ( type == ORDER_TYPE_BUY )
         tp = price + TakeProfit;
      else
         tp = price - TakeProfit;
   }

   price = NormalizeDouble( price, Digits() );
   sl    = NormalizeDouble( sl, Digits() );
   tp    = NormalizeDouble( tp, Digits() );

   PrintFormat( "OPEN %s: price=%f, SL SlowMA+/-%.1fp=%f (odleglosc %.1f pips), TP=%f",
                EnumToString( type ), price, InpInitialSLOffsetPips, sl, distancePips, tp );

   if ( Trade.PositionOpen( Symbol(), type, InpOrderSize, price, sl, tp, InpTradeComment ) ) {
      return true;
   }

   PrintFormat( "Open failed for %s, %s, price=%f, sl=%f, tp=%f. Retcode=%u (%s)",
                Symbol(), EnumToString( type ), price, sl, tp,
                Trade.ResultRetcode(), Trade.ResultRetcodeDescription() );
   return false;
}


// Zamkniecie zysku wzgledem TRZECIEJ sredniej Exit MA.
// Domyslnie Exit MA = EMA 50.
// BUY  -> pozycja musi byc na plusie i BID musi zejsc do Exit MA - offset.
// SELL -> pozycja musi byc na plusie i ASK musi wejsc do Exit MA + offset.
// Fast MA i Slow MA nadal sluza do sygnalu wejscia; Slow MA nadal wyznacza poczatkowy SL.
void ApplyExitMAProfitExit() {

   double exitNow[1];
   if ( CopyBuffer( ExitHandle, 0, InpExitMAShift, 1, exitNow ) < 1 )
      return;

   double exitMA = exitNow[0];
   double offset = PipsToDouble( InpProfitExitOffsetPips );
   double bid    = SymbolInfoDouble( Symbol(), SYMBOL_BID );
   double ask    = SymbolInfoDouble( Symbol(), SYMBOL_ASK );

   for ( int i = PositionsTotal() - 1; i >= 0; i-- ) {
      ulong ticket = PositionGetTicket( i );
      if ( !PositionSelectByTicket( ticket ) ) continue;

      if ( PositionGetString( POSITION_SYMBOL ) != Symbol() ) continue;
      if ( (int)PositionGetInteger( POSITION_MAGIC ) != InpMagic ) continue;

      double profit = PositionGetDouble( POSITION_PROFIT );

      // Tym warunkiem zamykamy tylko pozycje, ktore sa aktualnie na plusie.
      if ( profit <= 0.0 ) continue;

      ENUM_POSITION_TYPE posType = (ENUM_POSITION_TYPE)PositionGetInteger( POSITION_TYPE );

      if ( posType == POSITION_TYPE_BUY ) {
         double closeLevel = exitMA - offset;

         if ( bid <= closeLevel ) {
            PrintFormat( "CLOSE BUY PROFIT: BID=%f <= ExitMA(%d)-%.1fp=%f, profit=%.2f",
                         bid, InpExitMABars, InpProfitExitOffsetPips, closeLevel, profit );

            if ( !Trade.PositionClose( ticket ) ) {
               PrintFormat( "Close BUY failed. Ticket=%I64u, Retcode=%u (%s)",
                            ticket, Trade.ResultRetcode(), Trade.ResultRetcodeDescription() );
            }
         }
      }
      else if ( posType == POSITION_TYPE_SELL ) {
         double closeLevel = exitMA + offset;

         if ( ask >= closeLevel ) {
            PrintFormat( "CLOSE SELL PROFIT: ASK=%f >= ExitMA(%d)+%.1fp=%f, profit=%.2f",
                         ask, InpExitMABars, InpProfitExitOffsetPips, closeLevel, profit );

            if ( !Trade.PositionClose( ticket ) ) {
               PrintFormat( "Close SELL failed. Ticket=%I64u, Retcode=%u (%s)",
                            ticket, Trade.ResultRetcode(), Trade.ResultRetcodeDescription() );
            }
         }
      }
   }
}


bool IsTradeAllowed() {

   return ( ( bool )MQLInfoInteger( MQL_TRADE_ALLOWED )              // Trading allowed in input dialog
            && ( bool )TerminalInfoInteger( TERMINAL_TRADE_ALLOWED ) // Trading allowed in terminal
            && ( bool )AccountInfoInteger( ACCOUNT_TRADE_ALLOWED )   // Is account able to trade, not locked out
            && ( bool )AccountInfoInteger( ACCOUNT_TRADE_EXPERT )    // Is account able to auto trade
   );
}

//- 9. Break-even: przesuwa SL tylko raz na cene wejscia.
void ApplyBreakEven() {

   double ask = SymbolInfoDouble( Symbol(), SYMBOL_ASK );
   double bid = SymbolInfoDouble( Symbol(), SYMBOL_BID );
   int    err;

   for ( int i = PositionsTotal() - 1; i >= 0; i-- ) {
      ulong ticket = PositionGetTicket( i );
      if ( !PositionSelectByTicket( ticket ) ) continue;
      if ( Position.Symbol() != Symbol() || Position.Magic() != InpMagic ) continue;

      double openPrice = Position.PriceOpen();
      double currentSL = Position.StopLoss();
      double tp        = Position.TakeProfit();
      double beSL      = NormalizeDouble( openPrice, Digits() );

      if ( Position.PositionType() == POSITION_TYPE_BUY ) {
         // Aktywacja dopiero gdy BID jest co najmniej trigger pips nad cena wejscia.
         // Jesli SL jest juz na cenie wejscia lub wyzej, nic wiecej nie przesuwamy.
         if ( bid >= openPrice + BreakEvenTrigger && ( currentSL == 0.0 || currentSL < beSL ) ) {
            ResetLastError();
            if ( !Trade.PositionModify( ticket, beSL, tp ) ) {
               err = GetLastError();
               PrintFormat( "Failed to set BUY break-even on ticket %I64u to %f, err=%i, retcode=%u (%s)",
                            ticket, beSL, err, Trade.ResultRetcode(), Trade.ResultRetcodeDescription() );
            }
            else {
               PrintFormat( "BREAK EVEN BUY: ticket=%I64u, SL ustawiony na cene wejscia %f", ticket, beSL );
            }
         }
      }
      else if ( Position.PositionType() == POSITION_TYPE_SELL ) {
         // Aktywacja dopiero gdy ASK jest co najmniej trigger pips pod cena wejscia.
         // Jesli SL jest juz na cenie wejscia lub nizej, nic wiecej nie przesuwamy.
         if ( ask <= openPrice - BreakEvenTrigger && ( currentSL == 0.0 || currentSL > beSL ) ) {
            ResetLastError();
            if ( !Trade.PositionModify( ticket, beSL, tp ) ) {
               err = GetLastError();
               PrintFormat( "Failed to set SELL break-even on ticket %I64u to %f, err=%i, retcode=%u (%s)",
                            ticket, beSL, err, Trade.ResultRetcode(), Trade.ResultRetcodeDescription() );
            }
            else {
               PrintFormat( "BREAK EVEN SELL: ticket=%I64u, SL ustawiony na cene wejscia %f", ticket, beSL );
            }
         }
      }
   }
}

